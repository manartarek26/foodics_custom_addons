<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_foodics" model="ir.ui.view">
        <field name="name">account.move.form.foodics</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_foodics_pos_orders" type="object"
                        class="oe_stat_button" icon="fa-cutlery"
                        invisible="foodics_pos_order_count == 0">
                    <field name="foodics_pos_order_count" widget="statinfo" string="Foodics Order"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
