<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_foodics_config_form_accounting" model="ir.ui.view">
        <field name="name">foodics.config.form.accounting</field>
        <field name="model">foodics.config</field>
        <field name="inherit_id" ref="foodics_base.view_foodics_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_sync_menu']" position="after">
                <button name="action_sync_taxes" type="object" string="Sync Taxes" invisible="not is_connected"/>
                <button name="action_sync_payment_methods" type="object" string="Sync Payment Methods"
                        invisible="not is_connected"/>
                <button name="action_pull_orders" type="object" string="Pull Orders" invisible="not is_connected"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_tax_mappings" type="object" class="oe_stat_button" icon="fa-percent">
                    <field name="tax_mapping_count" widget="statinfo" string="Taxes"/>
                </button>
                <button name="action_open_payment_methods" type="object" class="oe_stat_button" icon="fa-credit-card">
                    <field name="payment_method_count" widget="statinfo" string="Payment Methods"/>
                </button>
                <button name="action_open_pos_orders" type="object" class="oe_stat_button" icon="fa-file-text-o">
                    <field name="pos_order_count" widget="statinfo" string="POS Orders"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='tax_inclusive_pricing']" position="after">
                <field name="default_customer_id"/>
                <field name="fallback_product_id"/>
                <field name="last_order_reference" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
