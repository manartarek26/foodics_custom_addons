<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_foodics_webhook_log_list" model="ir.ui.view">
        <field name="name">foodics.webhook.log.list</field>
        <field name="model">foodics.webhook.log</field>
        <field name="arch" type="xml">
            <list string="Foodics Webhook Log">
                <field name="create_date" string="Received"/>
                <field name="event"/>
                <field name="config_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'processed'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'ignored'"/>
            </list>
        </field>
    </record>

    <record id="view_foodics_webhook_log_form" model="ir.ui.view">
        <field name="name">foodics.webhook.log.form</field>
        <field name="model">foodics.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Foodics Webhook Log">
                <header>
                    <button name="action_reprocess" type="object" string="Reprocess"
                            invisible="state == 'processed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,processed,error"/>
                </header>
                <sheet>
                    <group>
                        <field name="event"/>
                        <field name="config_id"/>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Raw Payload">
                            <field name="raw_payload" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_foodics_webhook_log" model="ir.actions.act_window">
        <field name="name">Foodics Webhook Log</field>
        <field name="res_model">foodics.webhook.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
