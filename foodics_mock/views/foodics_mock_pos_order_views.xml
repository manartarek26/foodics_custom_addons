<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_foodics_mock_pos_order_list" model="ir.ui.view">
        <field name="name">foodics.mock.pos.order.list</field>
        <field name="model">foodics.mock.pos.order</field>
        <field name="arch" type="xml">
            <list string="Mock POS Orders (accounting simulation)" decoration-success="status == 4"
                  decoration-danger="status == 5">
                <field name="number"/>
                <field name="foodics_id"/>
                <field name="app_id"/>
                <field name="branch"/>
                <field name="customer_name"/>
                <field name="status_label"/>
                <field name="total_price"/>
                <field name="last_event_sent"/>
            </list>
        </field>
    </record>

    <record id="view_foodics_mock_pos_order_form" model="ir.ui.view">
        <field name="name">foodics.mock.pos.order.form</field>
        <field name="model">foodics.mock.pos.order</field>
        <field name="arch" type="xml">
            <form string="Mock POS Order">
                <header>
                    <button name="action_send_created" type="object" string="Send order.created"
                            invisible="status != 1 or last_event_sent"/>
                    <button name="action_close_and_notify" type="object" string="Close &amp; Send order.updated"
                            class="btn-primary" invisible="status in (4, 5)"/>
                    <button name="action_close_without_notifying" type="object" string="Close WITHOUT Webhook"
                            invisible="status in (4, 5)"
                            help="Changes status to Closed but does not call the webhook - use this to test the Pull Orders cron/button instead of the webhook path."/>
                    <button name="action_create_return" type="object" string="Return This Order"
                            invisible="status != 4"/>
                    <button name="action_resend_update" type="object" string="Resend Update"
                            invisible="status not in (4, 5)"
                            help="Re-fires order.updated with the current data - use this to test that foodics_accounting handles a duplicate/replayed webhook safely (no duplicate invoice/payment)."/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="payments_balanced">
                        Payments (<field name="payments_total" nolabel="1" class="oe_inline"/>) do not add up to
                        the order total (<field name="total_price" nolabel="1" class="oe_inline"/>) yet - a real
                        till would not let you close this order.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not last_event_sent">
                        Last webhook: <field name="last_event_sent" nolabel="1" class="oe_inline"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="foodics_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="app_id"/>
                            <field name="number" readonly="1"/>
                            <field name="branch"/>
                            <field name="business_date"/>
                            <field name="status" readonly="1"/>
                            <field name="return_of_id" readonly="1" invisible="not return_of_id"/>
                        </group>
                        <group string="Customer (leave empty for a walk-in)">
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="customer_email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="status in (4, 5)">
                                <list editable="bottom">
                                    <field name="product"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="discount_amount"/>
                                    <field name="taxable"/>
                                </list>
                            </field>
                            <group>
                                <group string="Optional Charge">
                                    <field name="charge_name"/>
                                    <field name="charge_amount"/>
                                    <field name="charge_taxable"/>
                                </group>
                                <group string="Totals">
                                    <field name="rounding_amount" readonly="status in (4, 5)"/>
                                    <field name="subtotal_price"/>
                                    <field name="tax_amount"/>
                                    <field name="total_price"/>
                                </group>
                            </group>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids" readonly="status in (4, 5)">
                                <list editable="bottom">
                                    <field name="method"/>
                                    <field name="amount"/>
                                    <field name="tips"/>
                                </list>
                            </field>
                            <field name="payments_total"/>
                        </page>
                        <page string="Last Webhook Payload">
                            <field name="last_payload_sent" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_foodics_mock_pos_order" model="ir.actions.act_window">
        <field name="name">Mock POS Orders</field>
        <field name="res_model">foodics.mock.pos.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
