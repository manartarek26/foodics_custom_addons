<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Purchase Order - Foodics tab, sync badge and actions
         ================================================================ -->
    <record id="view_purchase_order_form_foodics" model="ir.ui.view">
        <field name="name">purchase.order.form.foodics</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="foodics_sync_state" column_invisible="1"/>
                <button name="action_foodics_retry_sync" type="object"
                        string="Retry Foodics Sync" class="btn-warning"
                        invisible="foodics_sync_state != 'error'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Foodics" name="foodics">
                    <group>
                        <group string="Mapping">
                            <field name="foodics_config_id"
                                   options="{'no_create': True}"/>
                            <field name="foodics_branch_id"/>
                            <field name="foodics_supplier_id"/>
                        </group>
                        <group string="Sync Status">
                            <field name="foodics_po_id"/>
                            <field name="foodics_state"/>
                            <field name="foodics_sync_state"/>
                            <field name="foodics_last_sync"/>
                            <field name="foodics_additional_cost"/>
                            <button name="action_open_foodics_log" type="object"
                                    class="oe_link" string="View Sync Log"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not foodics_currency_warning">
                        <field name="foodics_currency_warning"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not foodics_warehouse_warning">
                        <field name="foodics_warehouse_warning"/>
                    </div>
                    <field name="foodics_note" nolabel="1" readonly="1"
                           invisible="not foodics_note"/>
                </page>
            </xpath>
            <!-- Foodics mapping on each line -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_qty']"
                   position="after">
                <field name="foodics_item_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_list_foodics" model="ir.ui.view">
        <field name="name">purchase.order.list.foodics</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="foodics_state" optional="hide"/>
                <field name="foodics_sync_state" optional="show"
                       decoration-danger="foodics_sync_state == 'error'"/>
            </xpath>
        </field>
    </record>

</odoo>
